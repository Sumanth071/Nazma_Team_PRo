# Environment Variables
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# MongoDB (Leave empty to use built-in embedded in-memory MongoDB)
MONGODB_URI=

# JWT Secrets (Non-expiring for seamless presentation and testing)
JWT_SECRET=coloai_super_secure_jwt_secret_key_2026_polyps
JWT_EXPIRES_IN=never

# Storage Configuration (local or s3/minio)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Optional Redis Configuration (Leave empty to use in-memory queue fallback)
REDIS_URL=

# AI Microservice Port
AI_PORT=8000
